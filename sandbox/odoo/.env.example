# Copy of the variables setup.sh writes to .env.local (git-ignored). Values are generated locally per machine.
ODOO_DB_PASSWORD=<generated by setup.sh>
SENTINELLOOP_ODOO_URL=http://localhost:8069
SENTINELLOOP_ODOO_DB=sandbox
SENTINELLOOP_ODOO_KEY=<generated by setup.sh via odoo shell; 30-day key, scope rpc>
